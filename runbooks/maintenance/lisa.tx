// Access tutorials and documentation at [docs.txtx.sh](https://docs.txtx.sh) 
// to understand the syntax and discover the powerful features of txtx.

addon "stacks" {
  network_id = input.stacks_network_id
  rpc_api_url = input.stacks_api_url
  fee = 1000002
}

signer "deployer" "stacks::web_wallet" {
  expected_address = input.stacks_deployer_address
}

// action "deploy-token-liabtc" "stacks::deploy_contract" {
//     contract = stacks::get_contract_from_clarinet_project("token-liabtc")
//     signer = signer.deployer    
// }

action "deploy-token-vliabtc" "stacks::deploy_contract" {
    contract = stacks::get_contract_from_clarinet_project("token-vliabtc")
    signer = signer.deployer    
}

// action "deploy-liabtc-mint-registry" "stacks::deploy_contract" {
//     contract = stacks::get_contract_from_clarinet_project("liabtc-mint-registry")
//     signer = signer.deployer    
// }

action "deploy-liabtc-mint-endpoint" "stacks::deploy_contract" {
    contract = stacks::get_contract_from_clarinet_project("liabtc-mint-endpoint")
    signer = signer.deployer    
}